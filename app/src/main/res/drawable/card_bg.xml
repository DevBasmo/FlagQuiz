<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Solid white card background for light mode -->
    <solid android:color="@color/background_color"/>

    <!-- Rounded corners for a modern card feel -->


    <!-- Soft gray border for definition against light background -->
    <stroke
        android:width="1dp"
        android:color="#E2E8F0"/>

    <!-- Padding so the flag doesn't touch edges -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp"/>
</shape>