<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/homemainlayout"
    android:background="@color/background_color"
    android:padding="20dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/tvLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/world_icon"
        android:contentDescription="@string/content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/flag_quiz"
        android:textColor="@color/text_color"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/subtitle"
        android:textColor="@color/learneveryflagonline"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Countries Available Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCountries"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_bg_light"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

              <ImageView
                  android:layout_width="20dp"
                  android:layout_height="20dp"
                  app:srcCompat="@drawable/world_icon"
                  android:contentDescription="@string/countries"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:text="@string/countries_available"
                  android:textColor="@color/text_color"
                  android:textSize="16sp"
                  android:textStyle="bold"/>

          </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/countries_available_description"
                android:textColor="@color/learneveryflagonline"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- PLAY NOW label -->
    <TextView
        android:id="@+id/tvPlayNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/play_now"
        android:textColor="@color/playnow"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/cardCountries"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start Quiz Button -->
    <Button
        android:id="@+id/btnStartQuiz"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/homebtntint"
        android:text="@string/start_quiz"
        android:textAllCaps="false"
        android:textColor="@color/button_white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvPlayNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quick Actions divider line (left) -->
    <View
        android:id="@+id/dividerLeft"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/homedivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvQuickActions"
        app:layout_constraintTop_toTopOf="@id/tvQuickActions"
        app:layout_constraintBottom_toBottomOf="@id/tvQuickActions" />
    <!-- Quick Actions label -->
    <TextView
        android:id="@+id/tvQuickActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/quick_actions"
        android:textColor="@color/playnow"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btnStartQuiz"
        app:layout_constraintStart_toEndOf="@id/dividerLeft"
        app:layout_constraintEnd_toStartOf="@id/dividerRight" />

    <!-- Quick Actions divider line (right) -->
    <View
        android:id="@+id/dividerRight"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/homedivider"
        app:layout_constraintStart_toEndOf="@id/tvQuickActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvQuickActions"
        app:layout_constraintBottom_toBottomOf="@id/tvQuickActions" />

    <!-- Row 1: Custom Quiz -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCustomQuiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg_light"
        app:layout_constraintTop_toBottomOf="@id/tvQuickActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardStatistics"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintWidth_percent="0.46">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp">

           <ImageView
               android:layout_width="28dp"
               android:layout_height="28dp"
               app:srcCompat="@drawable/world_icon"
               android:contentDescription="@string/custom_quiz"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/custom_quiz"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Row 1: Statistics -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatistics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg_light"
        app:layout_constraintTop_toTopOf="@id/cardCustomQuiz"
        app:layout_constraintStart_toEndOf="@id/cardCustomQuiz"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.46">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp">

            <ImageView
                android:layout_height="28dp"
                android:layout_width="28dp"
                app:srcCompat="@drawable/statistics_icon"
                android:contentDescription="@string/statistics"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/statistics"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Row 2: Achievements -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardExplore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg_light"
        app:layout_constraintTop_toBottomOf="@id/cardCustomQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardSettings"
        app:layout_constraintWidth_percent="0.46">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp">


           <ImageView
               android:layout_width="28dp"
               android:layout_height="28dp"
               app:srcCompat="@drawable/explore"
               android:contentDescription="@string/explore"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/explore"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Row 2: Settings -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_bg_light"
        app:layout_constraintTop_toTopOf="@id/cardExplore"
        app:layout_constraintStart_toEndOf="@id/cardExplore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.46">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/settings_icon"
                android:contentDescription="@string/settings"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/text_version"
        android:textColor="@color/playnow"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>